# Copie para .env e preencha (Supabase → Project Settings → API Keys).
# Use só a chave publicável (sb_publishable_...): ela vai para o navegador.
# Nunca coloque a secret key / service_role aqui.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# ---- Só no servidor (funções /api do Pix). Configure na Vercel:
# Project → Settings → Environment Variables. Não use NEXT_PUBLIC_ nelas.
# SUPABASE_SECRET_KEY: Supabase → Project Settings → API Keys → Secret keys (sb_secret_...)
# MP_ACCESS_TOKEN: Mercado Pago → Suas integrações → sua aplicação → Credenciais
#   (TEST-... para testar, APP_USR-... de produção para cobrar de verdade)
# SITE_URL: endereço do site, sem barra no final
SUPABASE_SECRET_KEY=
MP_ACCESS_TOKEN=
SITE_URL=https://seudominio.com.br
